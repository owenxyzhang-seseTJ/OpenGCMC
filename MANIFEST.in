include LICENSE README.md README.en.md README.ja.md
recursive-include native *.py *.cpp *.h *.cu
recursive-include examples *.json
recursive-include tools *.py *.cpp *.cu *.sh
recursive-include docs *.md *.bib *.svg *.png *.pdf
recursive-include figures *.py *.md *.csv *.json
recursive-include tests *.py *.cpp *.bin *.gpu
recursive-include benchmarks *.py *.json *.cif *.def *.input *.txt *.log *.npz *.csv restartfile
recursive-exclude benchmarks/runs *
recursive-exclude examples/longrange/cache *
recursive-exclude figures/.mplconfig *
exclude figures/source_data/layout_qa.json
recursive-exclude * __pycache__ *.pyc
